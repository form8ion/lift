{
  "name": "@form8ion/lift",
  "description": "tool for running sub-scaffolders on existing projects",
  "license": "MIT",
  "version": "0.0.0-semantically-released",
  "type": "module",
  "engines": {
    "node": "^22.21.0 || >=24.12"
  },
  "author": "Matt Travi <npm@travi.org> (https://matt.travi.org/)",
  "repository": "form8ion/lift",
  "bugs": "https://github.com/form8ion/lift/issues",
  "homepage": "https://npm.im/@form8ion/lift",
  "exports": "./lib/index.js",
  "main": "./lib/index.js",
  "sideEffects": false,
  "scripts": {
    "pretest": "run-s build",
    "test": "npm-run-all --print-label --parallel lint:* --parallel test:*",
    "lint:engines": "ls-engines",
    "lint:gherkin": "gherkin-lint",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "run-s 'lint:js -- --fix'",
    "lint:lockfile": "lockfile-lint",
    "lint:md": "remark . --frail",
    "lint:peer": "npm ls >/dev/null",
    "lint:publish": "publint --strict",
    "lint:sensitive": "ban",
    "test:unit": "run-s 'test:unit:base -- --coverage'",
    "test:unit:base": "DEBUG=any vitest run",
    "test:integration": "run-s 'test:integration:base -- --profile noWip'",
    "pretest:integration:base": "npm run build:js",
    "test:integration:base": "NODE_OPTIONS=--enable-source-maps cucumber-js test/integration",
    "test:integration:debug": "DEBUG=test run-s test:integration",
    "test:integration:focus": "run-s 'test:integration:base -- --profile focus'",
    "test:integration:wip": "run-s 'test:integration:base -- --profile wip'",
    "prebuild": "run-s clean",
    "build": "npm-run-all --print-label --parallel build:*",
    "build:js": "rollup --config",
    "clean": "rimraf ./lib",
    "pregenerate:md": "run-s build",
    "generate:md": "remark . --output",
    "prepack": "run-s build",
    "prepare": "husky",
    "watch": "run-s 'build:js -- --watch'"
  },
  "files": [
    "lib/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "npm@11.14.0+sha512.ea37d9cea2bc11f5869d379941ef9b80cc78220884667ee4d5e338184f1213cd41de261c879d9d55230ed610b63a735b14b230cefc14914c6c38e7143c6d9723",
  "dependencies": {
    "@form8ion/overridable-prompts": "^1.2.0",
    "@form8ion/project": "^22.0.0-beta.12",
    "git-url-parse": "^16.0.0",
    "simple-git": "^3.16.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.8.2",
    "@form8ion/commitlint-config": "2.0.13",
    "@form8ion/eslint-config": "7.1.0-beta.1",
    "@form8ion/eslint-config-cucumber": "1.4.1",
    "@form8ion/eslint-config-vitest": "1.1.0",
    "@form8ion/remark-lint-preset": "6.0.7",
    "@travi/any": "3.3.0",
    "@vitest/coverage-v8": "4.1.5",
    "ban-sensitive-files": "1.10.11",
    "chai": "6.2.2",
    "cross-env": "10.1.0",
    "cz-conventional-changelog": "3.3.0",
    "gherkin-lint": "4.2.4",
    "husky": "9.1.7",
    "lockfile-lint": "5.0.0",
    "ls-engines": "0.10.0",
    "mock-fs": "5.5.0",
    "npm-run-all2": "8.0.4",
    "publint": "0.3.20",
    "remark-cli": "12.0.1",
    "remark-toc": "9.0.0",
    "remark-usage": "11.0.1",
    "rimraf": "6.1.3",
    "rollup": "4.60.3",
    "rollup-plugin-auto-external": "2.0.0",
    "testdouble": "3.20.2",
    "vitest": "4.1.5",
    "vitest-when": "0.10.0"
  }
}
